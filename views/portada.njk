{% extends "base.njk" %}

{% block title %}Portada{% endblock %}

{% block content %}
  <h1 class="mb-4">Products</h1>

  <div class="row g-4">
    {% for card in cards %}
      <div class="col-md-4 col-lg-3">
        <div class="card h-100">
          <img
            src="/public/imagenes/{{ card.imagen | trim }}"
            class="card-img-top"
            alt="{{ card.titulo | trim }}"
          >
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">{{ card.titulo | trim }}</h5>
            <p class="card-text fw-bold">{{ card.precio }} €</p>
            <a href="/producto/{{ card.id }}" class="btn btn-primary mt-auto">View detail</a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endblock %}