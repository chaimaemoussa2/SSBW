---
interface Props {
  titulo: string;
  texto_precio: string;
  imagen: string;
}

const { titulo, texto_precio, imagen } = Astro.props;
---

<a href={`/productos/${encodeURIComponent(titulo)}`} class="block">
  <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition-shadow">
    <img 
      src={`/images/${imagen}`} 
      alt={titulo}
      class="w-full h-48 object-cover"
    />
    <div class="p-4">
      <h3 class="font-montserrat font-bold text-sm text-gray-700 line-clamp-2">{titulo}</h3>
      <p class="text-gray-500 mt-2">{texto_precio}</p>
    </div>
  </div>
</a>