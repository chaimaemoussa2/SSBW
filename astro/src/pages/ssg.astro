---
import LayoutPrado from '../layouts/LayoutPrado.astro';
import CardProducto from '../components/CardProducto.astro';
import productos from '../../data/productos.json';

const p = productos.slice(0, 12);
---

<LayoutPrado>
  <div class="flex flex-col gap-8 items-center">
    <section>
      <h1 class="font-montserrat text-4xl text-gray-700 tracking-widest">Destacados</h1>
    </section>
    <section class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8 pt-4">
      {p.map((producto) => (
        <CardProducto 
          titulo={producto.titulo} 
          texto_precio={producto.texto_precio} 
          imagen={producto.imagen}
        />
      ))}
    </section>
  </div>
</LayoutPrado>