---
import LayoutPrado from '../../layouts/LayoutPrado.astro';
import productos from '../../../data/productos.json';

export async function getStaticPaths() {
  return productos.map(pr => ({
    params: { slug: pr.titulo },
    props: { producto: pr }
  }));
}

const { producto } = Astro.props;
---

<LayoutPrado>
  <div class="flex flex-col md:flex-row gap-8 items-start max-w-4xl mx-auto">
    <div class="w-full md:w-1/2">
      <img 
        src={`/images/${producto.imagen}`} 
        alt={producto.titulo}
        class="w-full rounded-2xl shadow-md"
      />
    </div>
    <div class="w-full md:w-1/2">
      <h1 class="text-2xl font-bold text-gray-700 mb-4">{producto.titulo}</h1>
      <p class="text-xl font-bold text-yellow-600 mb-4">{producto.texto_precio}</p>
      <p class="text-gray-600 leading-relaxed">{producto.descripcion}</p>
      <a href="/ssg" class="mt-6 inline-block bg-gray-800 text-white px-6 py-3 rounded-xl hover:bg-gray-700">
        ← Volver
      </a>
    </div>
  </div>
</LayoutPrado>